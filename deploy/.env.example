# 复制为 .env 并按需填写。不要把真实密钥提交到 Git。

# OpenAlex / Crossref 礼貌池邮箱（可选，填了配额更稳）
OPENALEX_MAILTO=
CROSSREF_MAILTO=

# Semantic Scholar API key（可选，提额；无 key 也能用）
S2_API_KEY=

# —— 以下是 Dify 里配置模型供应商时要用的 key，通常在 Dify 界面里填，
#    这里仅作清单提醒，按你选用的模型准备其一即可 ——
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
