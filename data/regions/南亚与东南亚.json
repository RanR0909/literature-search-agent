 {
  "mmsid": "991021903105403966",
  "name": "AMD Ethnomusicology :Global Field Recordings",
  "lang": "eng",
  "type": "档案",
  "ext": "子库",
  "sub": "历史学;艺术学;交叉学科",
  "intro": "收录来自西非、北美和东南亚等全球60多个具有民族文化特色的地方的珍贵的民族与种族音乐史资料，包括民族音乐家与民间艺人的访谈资料，来自北美印第安人、犹太人和爪哇人等群体创作的音乐作品手稿等，从多元文化视角与不同民族文化特色视域下对全球民族与种族音乐史进行深入研究，涵盖文化交融、多元文化传统认同、民族音乐历史与传承、音乐与艺术表达、宗教音乐与礼仪、性别与音乐表现、传统音乐史与发展等多个研究范畴，内容极为全面。文献来源于美国加州大学洛杉矶分校民族音乐档案馆（UCLA Ethnomusicology Archive）以及华盛顿大学（University of Washington），时间覆盖1950-1980年。",
  "tier": "T1",
  "urls": [
   "http://tlink.lib.tsinghua.edu.cn/go?url=https://www.ethnomusicology.amdigital.co.uk"
  ],
  "mirror": [],
  "other": [],
  "offcampus": "本库可通过以下方式实现校外远程访问<br />①<a href=\"http://tlink.lib.tsinghua.edu.cn/go?url=https://www.ethnomusicology.amdigital.co.uk\">  智能网关</a><br />②<a target=\"_blank\" href=\"${global.offcampus.exproxy}\">  校外访问控制系统</a><br />③<a target=\"_blank\" href=\"${global.offcampus.myloft.url}\">  MyLoft远程访问插件</a>（<a target=\"_blank\" href=\"${global.offcampus.myloftpdf.url}\">注册安装指南</a>）<br />",
  "notice": "<p><span style=\"font-family: 微软雅黑, sans-serif;\">1.</span><span style=\"font-family: 微软雅黑, sans-serif;\">无并发用户数限制。</span></p>",
  "accessurl": ""
 },
 {
  "mmsid": "991021775122003966",
  "name": "AMD Foreign Office Files for India, Pakistan and Afghanistan, 1947-1980",
  "lang": "eng",
  "type": "档案",
  "ext": "子库",
  "sub": "历史学;法学;交叉学科",
  "intro": "包含三个部分内容：1.独立、分裂和尼赫鲁时代，1947-1964；2.南亚冲突和孟加拉国的独立，1965-1971；3.阿富汗和冷战，印度的紧急管制，巴基斯坦恢复文官统治，1972-1980。另外，还收录有孟加拉国、斯里兰卡、尼泊尔、不丹、锡金和克什米尔以及其他边境地区的内容。收录文献来源于英国国家档案馆（The National Archives，UK），是研究这一时期印度、巴基斯坦和阿富汗政治和社会历史的重要史料。",
  "tier": "T1",
