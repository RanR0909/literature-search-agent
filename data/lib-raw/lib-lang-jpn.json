{"code":200,"msg":"请求成功","data":[{"id":491,"databasename":"CNKI中国知网 境外专利数据库（知网版）","databasealias":"海外专利摘要数据库;CNKI","language":"eng;jpn;ger;fre;rus;kor;chi","firstsubject":"综合","secondsubject":"","databaseurl":"https://kns.cnki.net/kns8s/advsearch?dbcode=SOPD&language=CHS&uniplatform=NZKPT","databasetype":"专利","esubject":null,"letter":"C","description":null,"introduction":"收录从1970年至今专利1.2余亿项，每年新增专利约255万项。","newtag":0,"yearrange":null,"detailurl":"http://ecollection.lib.tsinghua.edu.cn/databasenav/entrance/detail?mmsid=991021765734403966","databaseext":"子库","mmsid":"991021765734403966","common":0,"collectionid":null,"edatabasename":null,"eintroduction":null,"databaselangtype":null,"databasestate":"订购库","status":"更新","updatedate":"2026-03-05 03:06:09","display":true,"updateuser":"liuyang","updatetime":"2026-03-09 10:51:41","urlstatus":false,"databaseotheralias":null,"databasemirrorurl":"","databaseotherurl":"","databaseurljson":"[{\"z\": \"Connect to the database platform\", \"url\": \"https://kns.cnki.net/kns8s/advsearch?dbcode=SOPD&language=CHS&uniplatform=NZKPT\"}]","databasemirrorurljson":null,"databaseotherurljson":null,"customstatus":null,"databasenamesort":"cnkizhongguozhiwang jingwaizhuanlishujuku（zhiwangban）","highlight":null,"aliasHighlight":[],"urls":["http://tlink.lib.tsinghua.edu.cn/go?url=https://kns.cnki.net/kns8s/advsearch?dbcode=SOPD&language=CHS&uniplatform=NZKPT"],"mirrorurls":[],"otherurls":[]},{"id":630,"databasename":"雕龙中日古籍全文资料库","databasealias":"","language":"chi;jpn","firstsubject":"哲学;文学;历史学","secondsubject":"","databaseurl":"http://tk.cepiec.com.cn/ancientc/ancientkm","databasetype":"古籍","esubject":null,"letter":"D","description":null,"introduction":"收录的子库包括：1.四库全书； 2.四库存目书；3.四库未收书；4.四库禁毁书；5.续修四库全书；6.四部丛刊；7.续四部丛刊；8.正统道藏；9.道藏辑要；10.清代史料；11.敦煌史料；12.永乐大典；13.古今图书集成；14.中国地方志；15.中国地方志续集；16.清代朱卷；17.中国民间文学；18.六府文藏；19.医家库；20.日本古典书籍。《雕龙中日古籍全文资料库》是一个大型中国古籍全文检索数据库，全库含书3万多种，近80亿字，且数据每年尚在增加中。","newtag":0,"yearrange":null,"detailurl":"http://ecollection.lib.tsinghua.edu.cn/databasenav/entrance/detail?mmsid=991021785239203966","databaseext":"主库","mmsid":"991021785239203966","common":0,"collectionid":null,"edatabasename":null,"eintroduction":null,"databaselangtype":null,"databasestate":"订购库","status":"更新","updatedate":"2023-12-20 09:44:04","display":true,"updateuser":"liuyang","updatetime":"2022-09-26 11:50:54","urlstatus":false,"databaseotheralias":null,"databasemirrorurl":"","databaseotherurl":"","databaseurljson":"[{\"z\": \"Connect to the database platform\", \"url\": \"http://tk.cepiec.com.cn/ancientc/ancientkm\"}]","databasemirrorurljson":null,"databaseotherurljson":null,"customstatus":null,"databasenamesort":"diaolongzhongrigujiquanwenziliaoku","highlight":null,"aliasHighlight":[],"urls":["http://tlink.lib.tsinghua.edu.cn/go?url=http://tk.cepiec.com.cn/ancientc/ancientkm"],"mirrorurls":[],"otherurls":[]},{"id":812,"databasename":"雕龙中日古籍全文资料库 日本古典书籍","databasealias":"日本古典书籍","language":"chi;jpn","firstsubject":"哲学;文学;历史学","secondsubject":"","databaseurl":"http://tk.cepiec.com.cn/ancientc/ancientkm","databasetype":"古籍","esubject":null,"letter":"D","description":null,"introduction":"《日本古典书籍库》主要是由《六国史》《本朝文粹注释》《倭名类聚钞》《新撰字镜》《国史大系》《国史大系续》《赖山阳全书》和《日本汉诗》组成。其中日本最古的史书《六国史》就是模拟《史记》《汉书》来写的，《本朝文粹注释》又是模仿中国《文选》格式的诗歌文集，数字化日本古籍对衬托中国古籍和研究日本文化根源有着重要的意义。《倭名类聚抄》《新撰字镜》这类资料在国内极其稀见，然而对于古汉语、古文献、古代史等领域的研究却十分重要。 所以可以说《日本古典书籍库》即增添了日本古籍数字化的光彩，也弥补了国内这方面资料的空缺。","newtag":0,"yearrange":null,"detailurl":"http://ecollection.lib.tsinghua.edu.cn/databasenav/entrance/detail?mmsid=991021905061703966","databaseext":"子库","mmsid":"991021905061703966","common":0,"collectionid":null,"edatabasename":null,"eintroduction":null,"databaselangtype":null,"databasestate":"订购库","status":"更新","updatedate":"2023-12-20 09:44:05","display":true,"updateuser":"liuyang","updatetime":"2023-03-29 10:02:54","urlstatus":false,"databaseotheralias":null,"databasemirrorurl":"","databaseotherurl":"","databaseurljson":"[{\"z\": \"Connect to the database platform\", \"url\": \"http://tk.cepiec.com.cn/ancientc/ancientkm\"}]","databasemirrorurljson":null,"databaseotherurljson":null,"customstatus":null,"databasenamesort":"diaolongzhongrigujiquanwenziliaoku ribengudianshuji","highlight":null,"aliasHighlight":[],"urls":["http://tlink.lib.tsinghua.edu.cn/go?url=http://tk.cepiec.com.cn/ancientc/ancientkm"],"mirrorurls":[],"otherurls":[]},{"id":763,"databasename":"J-STAGE","databasealias":"Japan Science and Technology Information;Explore Japan's academic journals","language":"jpn;eng","firstsubject":"综合","secondsubject":"","databaseurl":"https://www.jstage.jst.go.jp/static/pages/JstageOverview/-char/en","databasetype":"期刊","esubject":null,"letter":"J","description":null,"introduction":"J-STAGE is an electronic journal platform for science and technology information in Japan, developed and managed by the Japan Science and Technology Agency (JST). J-STAGE aims to accelerate the speed of communication and ensure the internationalization of the science and technology information published in Japan. By providing an online publication platform, J-STAGE supports Japanese societies and research organizations, and has published more than 3,000 journals, conference proceedings and other academic publications with high speeds at low costs.J-STAGE offers support to publishers in the form of the entire publication process, from submission and peer-review process to publishing. J-STAGE users can also access and create their own libraries of information anytime and anywhere with the assistance of J-STAGE. These libraries can be used on multiple devices.","newtag":0,"yearrange":null,"detailurl":"https://ecollection.lib.tsinghua.edu.cn/databasenav/entrance/detail?mmsid=991021889776403966","databaseext":"主库","mmsid":"991021889776403966","common":0,"collectionid":null,"edatabasename":null,"eintroduction":null,"databaselangtype":null,"databasestate":"免费库","status":"更新","updatedate":"2024-11-12 03:06:11","display":true,"updateuser":"wulina","updatetime":"2021-12-04 09:04:00","urlstatus":false,"databaseotheralias":null,"databasemirrorurl":"","databaseotherurl":"","databaseurljson":"[{\"z\": \"Connect to the database platform\", \"url\": \"https://www.jstage.jst.go.jp/static/pages/JstageOverview/-char/en\"}]","databasemirrorurljson":null,"databaseotherurljson":null,"customstatus":null,"databasenamesort":"j-stage","highlight":null,"aliasHighlight":[],"urls":["https://www.jstage.jst.go.jp/static/pages/JstageOverview/-char/en"],"mirrorurls":[],"otherurls":[]},{"id":288,"databasename":"JapanKnowledge Lib","databasealias":"ジャパンナレッジ Lib.","language":"jpn;eng","firstsubject":"综合","secondsubject":"","databaseurl":"https://japanknowledge.com/library/","databasetype":"图书;词典;百科全书","esubject":null,"letter":"J","description":null,"introduction":"收录日本著名的百科事典、辞典等大量知识信息的在线数据库。除了日本语、英语等语言学辞典外，产品还包括历史事典、东洋文库、日本古典文学全集等50余种各领域资源，所有信息均可一键检索，涉及学科类别包括百科、日本语、历史、英语、欧洲语系、东亚语系、用语、情报、人名、文化、宗教、科学、记事、专栏、丛书等。","newtag":0,"yearrange":null,"detailurl":"http://ecollection.lib.tsinghua.edu.cn/databasenav/entrance/detail?mmsid=991021558928203966","databaseext":"主库","mmsid":"991021558928203966","common":0,"collectionid":null,"edatabasename":null,"eintroduction":null,"databaselangtype":null,"databasestate":"订购库","status":"更新","updatedate":"2024-11-12 03:06:10","display":true,"updateuser":"liuyang","updatetime":"2023-12-21 16:39:54","urlstatus":false,"databaseotheralias":null,"databasemirrorurl":"","databaseotherurl":"","databaseurljson":"[{\"z\": \"Connect to the database platform\", \"url\": \"https://japanknowledge.com/library/\"}]","databasemirrorurljson":null,"databaseotherurljson":null,"customstatus":null,"databasenamesort":"japanknowledge lib","highlight":null,"aliasHighlight":[],"urls":["https://japanknowledge.com/library/"],"mirrorurls":[],"otherurls":[]},{"id":89,"databasename":"日経テレコン","databasealias":"日经数据库","language":"jpn","firstsubject":"经济学","secondsubject":"","databaseurl":"http://t21ipau.nikkei.co.jp/ipauth/auth/auth?sid=1","databasetype":"数据事实","esubject"